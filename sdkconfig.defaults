# Use the ESP32-S3's native USB peripheral (not the JTAG/serial one) as a USB device
CONFIG_TINYUSB_RHPORT_HS=n

# TinyUSB stack
CONFIG_TINYUSB=y
CONFIG_TINYUSB_HID_ENABLED=y
CONFIG_TINYUSB_HID_COUNT=1

# Descriptor strings
CONFIG_TINYUSB_DESC_USE_DEFAULT=n
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="DIY"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="ESP32S3 Drone Controller"
CONFIG_TINYUSB_DESC_SERIAL_STRING="123456"

# Make sure USB device mode is on (native USB, not USB-Serial-JTAG for this purpose)
CONFIG_USB_OTG_SUPPORTED=y

CONFIG_FREERTOS_HZ=1000
